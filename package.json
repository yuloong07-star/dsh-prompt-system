{
  "name": "dsh-prompt-system",
  "version": "0.1.0",
  "description": "提示词优化插件：模型选择左侧「优化提示词」按钮，结合当前对话与工作区文件，把草稿优化为「目标/实现措施/约束」三段式精准提示词，支持一键撤销",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "prompt-optimizer",
    "prompt-enhancement"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  }
}
